CLAUDE.md
# Internal planning/process notes under docs/: private, never version-controlled.
docs/**/*.md
data/
results/*
!results/summaries/
# Raw per-run evo output under results/summaries/eval* -- regenerates from eval_traj.py,
# never commit it (CLAUDE.md rule 5). The eval_traj*.csv summaries stay tracked.
results/summaries/eval*/
ws/build/
ws/install/
ws/log/
**/thirdparty/ctraj-build/
**/thirdparty/ctraj-install/
__pycache__/
.venv/
*.bag
*.db3
*.mcap

# Paper figure generation (scripts/paper_figures/) and its output (figures/) -- generated
# from results/, like everything under results/ itself: never commit.
scripts/paper_figures/
figures/

# Paper draft and downloaded reference PDFs: not part of this repo's version-controlled
# research record.
docs/paper_latex/
docs/paper_latex.zip
docs/*.pdf
